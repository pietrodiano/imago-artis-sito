{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/chi-siamo.html", "permanent": true },
    { "source": "/about/", "destination": "/chi-siamo.html", "permanent": true },
    { "source": "/services", "destination": "/catalogo.html", "permanent": true },
    { "source": "/services/", "destination": "/catalogo.html", "permanent": true },
    { "source": "/contact", "destination": "/contatti.html", "permanent": true },
    { "source": "/contact/", "destination": "/contatti.html", "permanent": true },
    { "source": "/blog-2", "destination": "/index.html", "permanent": true },
    { "source": "/blog-2/", "destination": "/index.html", "permanent": true },
    { "source": "/blog", "destination": "/index.html", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.imagoartisedizioni.it" }],
      "destination": "https://imagoartisedizioni.it/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).(webp|png|jpg|svg|mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
